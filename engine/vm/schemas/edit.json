{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.edit/schemas/edit.json",
  "title": "edit.json — решения монтажа для рендера",
  "type": "object",
  "required": ["speed", "keep", "words", "hook", "cta", "inserts", "zooms", "face", "music", "hold", "style"],
  "properties": {
    "speed": {
      "description": "Ускорение всего ролика (по умолчанию 1.1).",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "keep": {
      "description": "Отрезки исходника [начало, конец], которые остаются; по возрастанию, без пересечений.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number", "minimum": 0 }
      }
    },
    "words": {
      "description": "Слова субтитров с исправленным текстом.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t0", "t1", "text"],
        "properties": {
          "t0": { "type": "number", "minimum": 0 },
          "t1": { "type": "number", "minimum": 0 },
          "text": { "type": "string" }
        }
      }
    },
    "hook": {
      "description": "Хук в начале ролика, показывается до момента until, с. null — без хука.",
      "type": ["object", "null"],
      "required": ["text", "until"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "until": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cta": {
      "description": "Титр с кодовым словом: строки основным шрифтом, word — рукописным. null — без титра.",
      "type": ["object", "null"],
      "required": ["lines", "word", "t0", "t1"],
      "properties": {
        "lines": { "type": "array", "items": { "type": "string" } },
        "word": { "type": "string" },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "minimum": 0 }
      }
    },
    "inserts": {
      "type": "array",
      "items": { "$ref": "#/$defs/Insert" }
    },
    "zooms": {
      "description": "Ступени зума: с момента t (время исходника) уровень level.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "level"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "level": { "type": "number" }
        }
      }
    },
    "face": {
      "description": "Лицо в долях кадра: центр x, y; рамка w, h (необязательна).",
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/Fraction" },
        "y": { "$ref": "#/$defs/Fraction" },
        "w": { "$ref": "#/$defs/Fraction" },
        "h": { "$ref": "#/$defs/Fraction" }
      }
    },
    "music": {
      "description": "Фоновая музыка: файл и громкость в дБ. null — без музыки.",
      "type": ["object", "null"],
      "required": ["file", "gainDb"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "gainDb": { "type": "number" },
        "beats": {
          "description": "Монтаж в такт: смены зума и появления вставок встают на ближайшую долю трека (не дальше 0,25 с). Нет поля — да; false — время событий как в edit.json.",
          "type": "boolean"
        }
      }
    },
    "hold": {
      "description": "Стоп-кадр в конце, с.",
      "type": "number",
      "minimum": 0
    },
    "cover": {
      "description": "Обложка для сетки профиля: кадр исходника в t (с) и текст — хук крупно. vm render пишет out/<имя>-cover.png. null или нет поля — без обложки.",
      "type": ["object", "null"],
      "required": ["t", "text"],
      "properties": {
        "t": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "ab": {
      "description": "Вторая версия для A/B-теста (ответ Павла answers.ab): vm render соберёт ещё ролик <имя>-b без тизера (teaser) или без музыки (music). null или нет поля — один ролик.",
      "enum": ["teaser", "music", null]
    },
    "teaser": {
      "description": "Тизер: фраза исходника t0–t1 (1–5 с, по границам слов) звучит в самом начале ролика, а потом ещё раз на своём месте; хук стоит на ней целиком; sfx — звук на стыке с началом ролика. null или нет поля — тизера нет.",
      "type": ["object", "null"],
      "required": ["t0", "t1"],
      "properties": {
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "minimum": 0 },
        "sfx": { "type": ["string", "null"] }
      }
    },
    "end": {
      "description": "Финальная карточка: после стоп-кадра ещё seconds того же последнего кадра, затемнённого; поверх — призыв lines (1–2 строки, можно с эмодзи), @ник handle и логотип logo (путь от папки задачи) из бренда Павла; sfx — звук её появления. null или нет поля — карточки нет.",
      "type": ["object", "null"],
      "required": ["seconds", "lines"],
      "properties": {
        "seconds": { "type": "number", "minimum": 1, "maximum": 4 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "handle": { "type": ["string", "null"] },
        "logo": { "type": ["string", "null"] },
        "sfx": { "type": ["string", "null"] }
      }
    },
    "style": { "$ref": "styles.json#/$defs/StyleSpec" }
  },
  "$defs": {
    "Fraction": {
      "description": "Доля кадра, 0..1.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "Insert": {
      "type": "object",
      "required": ["kind", "t0", "t1"],
      "properties": {
        "kind": { "enum": ["image", "badge", "sticker", "text", "anim", "fullscreen"] },
        "src": { "type": "string" },
        "question": {
          "description": "id вопроса insert-<n> из questions.json: место и время вставки «добавь сюда» решены на шаге analyze, src (или стикер) — по ответу Павла на шаге render. Без src такая вставка в монтаж не идёт.",
          "type": "string",
          "minLength": 1
        },
        "id": {
          "description": "Ключ вставки без question и src — стикера-тезиса (kind text): s1, s2… По нему страница помнит, куда Павел передвинул вставку, а вопрос stickers включает и выключает её.",
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,24}$"
        },
        "text": { "type": "string" },
        "title": { "type": "string" },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "minimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "sfx": { "type": ["string", "null"] },
        "params": { "type": "object" }
      }
    }
  }
}
