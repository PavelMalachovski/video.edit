{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.edit/schemas/styles.json",
  "title": "styles.json — кадр для превью и три варианта стиля A/B/C",
  "type": "object",
  "required": ["frame", "frameTime", "sample", "variants"],
  "properties": {
    "frame": {
      "description": "Кадр для превью, путь от папки задачи (обычно frame.png).",
      "type": "string",
      "minLength": 1
    },
    "frameTime": {
      "description": "Время этого кадра в исходнике, с.",
      "type": "number",
      "minimum": 0
    },
    "sample": {
      "description": "Что показать на превью: текст хука и слова субтитров; spoken — индекс слова, которое «говорится» сейчас.",
      "type": "object",
      "required": ["words", "spoken"],
      "properties": {
        "hook": { "type": "string" },
        "words": { "type": "array", "items": { "type": "string" } },
        "spoken": { "type": "integer", "minimum": 0 },
        "end": {
          "description": "Финальная карточка на превью: призыв lines (страница заменит его ответом на вопрос end), @ник handle и логотип logo (путь от папки задачи) — из бренда Павла.",
          "type": "object",
          "required": ["lines"],
          "properties": {
            "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
            "handle": { "type": ["string", "null"] },
            "logo": { "type": ["string", "null"] }
          }
        },
        "inserts": {
          "description": "Вставки на кадре превью — страница рисует их тем же шаблоном. src — путь от папки задачи; question — id вопроса insert, от ответа на который зависит картинка (место — как у вставки с этим question в черновике edit.json); id — стикер-тезис (kind text): по нему страница помнит место и прячет стикер, который Павел снял в вопросе stickers.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "x", "y", "w"],
            "properties": {
              "kind": { "enum": ["image", "badge", "sticker", "text", "anim"] },
              "src": { "type": "string" },
              "text": { "type": "string" },
              "title": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "question": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,24}$" },
              "params": { "type": "object" }
            }
          }
        }
      }
    },
    "fonts": {
      "description": "Шрифты, в которых есть все буквы ролика (вывод vm fonts): страница предлагает Павлу только их. Нет поля — все.",
      "type": "object",
      "required": ["main", "hand"],
      "additionalProperties": false,
      "properties": {
        "main": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "hand": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "cover": {
      "description": "Обложка на превью: до трёх кадров исходника (t — с; image — картинка vm preview, путь от папки задачи) и текст — хук. Павел выбирает кадр и правит текст (answers.json cover).",
      "type": "object",
      "required": ["frames", "text"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["t", "image"],
            "properties": { "t": { "type": "number", "minimum": 0 }, "image": { "type": "string", "minLength": 1 } }
          }
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "variants": {
      "description": "Ровно три варианта в порядке A, B, C: A — строго по правилам SKILL.md, B и C — вариации.",
      "type": "array",
      "minItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/Variant", "properties": { "id": { "const": "A" } } },
        { "$ref": "#/$defs/Variant", "properties": { "id": { "const": "B" } } },
        { "$ref": "#/$defs/Variant", "properties": { "id": { "const": "C" } } }
      ],
      "items": false
    }
  },
  "$defs": {
    "Color": {
      "description": "Цвет #RRGGBB.",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "Variant": {
      "type": "object",
      "required": ["id", "label", "spec"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "spec": { "$ref": "#/$defs/StyleSpec" }
      }
    },
    "StyleSpec": {
      "description": "Спецификация стиля: по ней и страница (превью), и рендер рисуют слой текста. font и hand — id из template/fonts.json; размеры и y — пиксели кадра 1080×1920.",
      "type": "object",
      "required": ["font", "hand", "colors", "subtitles", "hook", "bar"],
      "properties": {
        "font": { "type": "string", "minLength": 1 },
        "hand": { "type": "string", "minLength": 1 },
        "colors": {
          "type": "object",
          "required": ["text", "accent", "bar", "plate", "outline"],
          "properties": {
            "text": { "$ref": "#/$defs/Color" },
            "accent": { "$ref": "#/$defs/Color" },
            "bar": { "$ref": "#/$defs/Color" },
            "plate": { "$ref": "#/$defs/Color" },
            "outline": { "$ref": "#/$defs/Color" }
          }
        },
        "subtitles": {
          "type": "object",
          "required": ["mode", "words", "size", "y"],
          "properties": {
            "mode": { "enum": ["karaoke", "plate", "word", "accumulate"] },
            "words": { "type": "integer", "minimum": 2, "maximum": 6 },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "minimum": 0, "maximum": 1920 }
          }
        },
        "hook": {
          "type": "object",
          "required": ["mode", "size"],
          "properties": {
            "mode": { "enum": ["plate", "outline", "shadow"] },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "y": {
              "description": "Центр хука (строки капсом) по вертикали, px кадра; нет — 400. Титр с кодовым словом — на той же высоте.",
              "type": "number",
              "minimum": 120,
              "maximum": 1530
            }
          }
        },
        "bar": {
          "type": "object",
          "required": ["pos", "height"],
          "properties": {
            "pos": { "enum": ["bottom", "top"] },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
