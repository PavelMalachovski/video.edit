{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.edit/schemas/result.json",
  "title": "result.json — что сделано, в чём не уверен, чего не хватило, итог проверки",
  "type": "object",
  "required": ["durations", "done", "unsure", "missing", "qa"],
  "properties": {
    "durations": {
      "type": "object",
      "required": ["source", "final"],
      "properties": {
        "source": { "type": "number", "minimum": 0 },
        "final": { "type": "number", "minimum": 0 }
      }
    },
    "done": {
      "description": "Что сделано: вырезки, вставки, стиль.",
      "type": "array",
      "items": { "type": "string" }
    },
    "unsure": {
      "description": "Слова и места, в которых Claude не уверен.",
      "type": "array",
      "items": { "type": "string" }
    },
    "missing": {
      "description": "Чего не хватило (нет музыки, шрифта, звуков) — смонтировано без этого.",
      "type": "array",
      "items": { "type": "string" }
    },
    "caption": {
      "description": "Подпись к посту (пишет Claude на шаге render): text — на языке ролика, первая строка — главное в 72 знаках (столько Instagram показывает до «ещё»); hashtags — без «#», 3–5.",
      "type": "object",
      "required": ["text", "hashtags"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2200 },
        "hashtags": { "type": "array", "maxItems": 30, "items": { "type": "string", "pattern": "^[^\\s#]{1,60}$" } }
      }
    },
    "ab": {
      "description": "Вторая версия A/B-теста (её собирает vm render, если в edit.json есть ab): чем отличается, длительности и проверка.",
      "type": "object",
      "required": ["differs", "durations", "qa"],
      "properties": {
        "differs": { "enum": ["teaser", "music"] },
        "durations": { "$ref": "#/properties/durations" },
        "qa": { "$ref": "#/properties/qa" }
      }
    },
    "qa": {
      "type": "object",
      "required": ["ok", "problems"],
      "properties": {
        "ok": { "type": "boolean" },
        "problems": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
